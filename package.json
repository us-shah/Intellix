{
  "name": "intellix-platform",
  "version": "2.1.5",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node scripts/dev-backend.mjs",
    "typecheck": "npm --prefix frontend run typecheck",
    "build": "npm --prefix frontend run build",
    "check:backend": "python -m compileall -q backend/app",
    "check": "npm run typecheck && npm run check:backend"
  }
}
